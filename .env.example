# LLM Provider Configuration
# Supported: openai, anthropic, openrouter, ollama, or any LiteLLM-compatible provider

# Option 1: OpenAI
OPENAI_API_KEY=sk-xxx

# Option 2: Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Option 3: OpenRouter (access 200+ models)
OPENROUTER_API_KEY=sk-or-xxx

# Option 4: Ollama (local, no key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Default model (LiteLLM format)
# Examples: gpt-4o, claude-sonnet-4-20250514, openrouter/anthropic/claude-sonnet-4, ollama/llama3
DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4
